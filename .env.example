# Optional bearer-token protection for API endpoints other than / and /health.
PHI_API_TOKEN=change-me-to-a-long-random-secret

# Optional OpenAI-compatible provider configuration for /ask
PHI_API_BASE_URL=
PHI_API_KEY=
PHI_MODEL=

# Use a persistent mounted disk path if persistent memory is required.
PHI_DATA_DIR=/tmp/phi-expert-data
